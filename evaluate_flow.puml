@startuml
title evaluate.py - Выбор вопроса и статус ответа

start

:Загрузка списка вопросов и ожидаемых статусов из golden_questions.json;
:Инициализация таблицы сравнений;

while (Есть следующий вопрос?) is (да)
  :Выбрать вопрос;
  :Найти релевантные чанки;
  :Сформировать ответ;
  :Оценить качество ответа (quality.label);

  if (Чанки не найдены?) then (да)
    :Статус поиска = "не нашлось";
  else (нет)
    if (Доля чанков >= порога\nбольше 20%?) then (да)
      :Статус поиска = "релевантно";
    else (нет)
      :Статус поиска = "нерелевантно";
    endif
  endif

  :Сравнить expected status и actual quality.label;
  :Добавить строку в comparisons;
  :Записать результат в bot_log.json;
endwhile (нет)

:Печать таблицы сравнений (OK/FAIL);
if (Все статусы совпали?) then (да)
  :Вердикт = "ожидаемые ответы совпали";
else (нет)
  :Вердикт = "ожидаемые ответы не совпали";
endif

stop

@enduml
